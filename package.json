{
  "name": "@tteja/node-red-dashboard-2-robot-arm",
  "version": "0.3.0",
  "description": "Node-RED + FlowFuse Dashboard 2 robot arm: realistic UR5e URDF/STL viewer, teach pendant, optional ROS2 rosbridge. Palette: robot-arm, robot-arm-controller, ui-ur5e-arm, ui-ur5e-controller.",
  "author": "Teja",
  "license": "MIT",
  "keywords": [
    "node-red",
    "node-red-dashboard-2",
    "robotics",
    "urdf",
    "ros2",
    "three.js",
    "robot-arm",
    "ur5e"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-teja/node-red-contrib-robot-arm.git"
  },
  "bugs": {
    "url": "https://github.com/t-teja/node-red-contrib-robot-arm/issues"
  },
  "homepage": "https://github.com/t-teja/node-red-contrib-robot-arm#readme",
  "files": [
    "nodes/*",
    "lib/*",
    "models/**/*",
    "resources/*",
    "ui/components/*",
    "ui/index.js",
    "examples/*",
    "docs/*",
    "LICENSE",
    "README.md"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "robot-arm": "nodes/robot.js",
      "robot-arm-controller": "nodes/controller.js",
      "ui-ur5e-arm": "nodes/ui-robot-arm.js",
      "ui-ur5e-controller": "nodes/ui-robot-controller.js"
    },
    "examples": {
      "Inject demo": "examples/01-inject-demo.json",
      "Controller to robot": "examples/02-controller-to-robot.json",
      "Rosbridge live": "examples/03-rosbridge-live.json",
      "Controller and ROS2": "examples/04-controller-and-ros2.json",
      "Dashboard 2": "examples/05-dashboard2.json"
    }
  },
  "node-red-dashboard-2": {
    "version": "1.0.0",
    "widgets": {
      "ui-ur5e-arm": {
        "output": "robot-arm-widgets.umd.js",
        "component": "UIRobotArm"
      },
      "ui-ur5e-controller": {
        "output": "robot-arm-widgets.umd.js",
        "component": "UIRobotController"
      }
    }
  },
  "dependencies": {
    "three": "^0.186.1",
    "urdf-loader": "^0.13.1",
    "vue": "^3.3.8",
    "vuex": "^4.1.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@flowfuse/node-red-dashboard": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@flowfuse/node-red-dashboard": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@flowfuse/node-red-dashboard": ">=1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "NODE_ENV=development vite build",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
